# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Web Search API Key (optional)
TAVILY__APIKEY=your_tavily_api_key_here

# MongoDB Configuration (optional, in-memory store used if empty)
# uncomment both when using `docker compose --profile mongo up`:
# MongoDb__ConnectionString=mongodb://mongo:27017
# MongoDb__DatabaseName=BuddyBee

# CORS Configuration (comma-separated origins)
Cors__AllowedOrigins=http://localhost:5173

# Frontend API URL (passed as build arg to Vite frontend)
VITE_API_URL=http://localhost:8080
